+    def _execute_command(command: list, return_output=False, timeout_seconds=None):
+        # COPASI extension: explicit binary, checked completion, bounded lifetime.
+        import json
+        command = list(command)
+        if os.path.basename(command[0]).lower() in ('vmrun', 'vmrun.exe'):
+            command[0] = os.environ.get('OSWORLD_VMRUN_PATH', 'vmrun')
+        is_ip = 'getGuestIPAddress' in command
+        started_ns = time.time_ns()
+        def record(code, stdout, stderr, error=None):
+            trace = os.environ.get('COPASI_VM_IP_TRACE')
+            if not is_ip or not trace:
+                return
+            def raw(value):
+                data = value if isinstance(value, bytes) else str(value or '').encode('utf-8')
+                return {'hex': data[:8192].hex(), 'utf8_repr': repr(data.decode('utf-8', errors='replace'))[:8192]}
+            row = {'started_ns': started_ns, 'ended_ns': time.time_ns(), 'pid': os.getpid(),
+                   'argv': command, 'returncode': code, 'stdout': raw(stdout), 'stderr': raw(stderr), 'error': error}
+            os.makedirs(os.path.dirname(os.path.abspath(trace)), exist_ok=True)
+            with open(trace, 'a', encoding='utf-8') as stream:
+                stream.write(json.dumps(row, ensure_ascii=False) + '\n')
+        try:
+            result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                                    timeout=timeout_seconds if timeout_seconds is not None else (15 if is_ip else 120), check=True)
+        except subprocess.CalledProcessError as exc:
+            record(exc.returncode, exc.stdout, exc.stderr, type(exc).__name__)
+            raise
+        except subprocess.TimeoutExpired as exc:
+            record(None, exc.stdout, exc.stderr, type(exc).__name__)
+            raise
+        record(result.returncode, result.stdout, result.stderr)
+        text = result.stdout.decode('utf-8-sig', errors='replace') if isinstance(result.stdout, bytes) else result.stdout
+        return text.strip() if return_output else None
 
