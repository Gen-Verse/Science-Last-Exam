# =============================================================================
# .env.example: copy to secret/.env and fill in what you use. secret/.env is gitignored.
#
# evaluate.py and the scripts read secret/.env at start, so nothing needs to be exported.
# Variables already set in the shell win: `export FOO=bar` overrides this file for one run.
# Format: KEY=value per line; `#` starts a comment; quotes around values are stripped.
# =============================================================================

# ---- Model API keys: the variable your profile names in api_key_env --------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Hugging Face: reads the gated reference dataset (or run `hf auth login`)
HF_TOKEN=

# ---- End-to-End Science providers (env/closeloop/profiles) -----------------
# openai: path to a Codex auth.json readable only by you
SLE_CODEX_AUTH_FILE=
# ark: key for an endpoint serving the OpenAI Responses API
SLE_ARK_API_KEY=
