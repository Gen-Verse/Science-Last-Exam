#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: scientific-gui
    username: user
    password: "${password_hash}"
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: direct
  packages:
    - sudo
  user-data:
    timezone: Etc/UTC
  late-commands:
    - curtin in-target --target=/target -- sh -c 'echo "user ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/scientific-gui-build'
    - curtin in-target --target=/target -- chmod 440 /etc/sudoers.d/scientific-gui-build
